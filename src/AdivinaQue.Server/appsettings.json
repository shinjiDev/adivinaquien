{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "InMemory",
    "SqliteConnectionString": "Data Source=adivinaque.db"
  },
  "Match": {
    "AnswerTimeoutSeconds": 60,
    "DisconnectGraceSeconds": 120,
    "WrongGuessPolicy": "EndsMatch"
  },
  "Room": {
    "TtlMinutes": 30,
    "SweepIntervalSeconds": 1
  }
}
