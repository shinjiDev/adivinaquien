@page "/"
@inject GameClient GameClient
@inject NavigationManager Navigation

<PageTitle>Guess Who? Chilean historical characters</PageTitle>

<div class="home-screen">
    <h1>Guess Who?</h1>
    <p class="lead">Guess your rival's secret character — Chilean historical characters, 2 players.</p>

    <button class="btn btn-primary btn-lg w-100 mb-4" @onclick="CreateAsync" disabled="@_busy">
        Create room
    </button>

    <form @onsubmit="JoinAsync" @onsubmit:preventDefault>
        <label for="code" class="form-label">Join with a code</label>
        <input id="code" class="form-control text-uppercase mb-2" maxlength="6" @bind="_code" placeholder="ABC123" />
        <button type="submit" class="btn btn-outline-primary w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(_code))">
            Join
        </button>
    </form>

    @if (_error is not null)
    {
        <p class="text-danger mt-3">@_error</p>
    }
</div>

@code {
    private string _code = string.Empty;
    private bool _busy;
    private string? _error;

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        var ok = await GameClient.CreateRoomAsync();
        _busy = false;

        if (ok && GameClient.RoomCode is not null)
        {
            Navigation.NavigateTo($"/room/{GameClient.RoomCode}");
        }
        else
        {
            _error = "Could not create the room.";
        }
    }

    private async Task JoinAsync()
    {
        _busy = true;
        _error = null;
        var code = _code.Trim().ToUpperInvariant();
        var ok = await GameClient.JoinRoomAsync(code);
        _busy = false;

        if (ok)
        {
            Navigation.NavigateTo($"/room/{code}");
        }
        else
        {
            _error = GameClient.LastError?.Message ?? "Could not join the room.";
        }
    }
}
