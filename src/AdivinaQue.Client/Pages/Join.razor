@page "/join/{code}"
@inject GameClient GameClient
@inject NavigationManager Navigation

<PageTitle>Join room @Code</PageTitle>

<div class="home-screen">
    <h1>Room @Code</h1>

    @if (_error is null)
    {
        <p>Joining the room…</p>
    }
    else
    {
        <p class="text-danger">@_error</p>
        <a class="btn btn-primary" href="/">Back to home</a>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var code = Code.Trim().ToUpperInvariant();
        var ok = await GameClient.JoinRoomAsync(code);

        if (ok)
        {
            Navigation.NavigateTo($"/room/{code}", replace: true);
        }
        else
        {
            _error = GameClient.LastError?.Message ?? "Could not join the room.";
        }
    }
}
