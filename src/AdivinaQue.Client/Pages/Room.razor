@page "/room/{code}"
@implements IDisposable
@inject GameClient GameClient
@inject NavigationManager Navigation

<PageTitle>Room @Code</PageTitle>

@if (_error is not null)
{
    <div class="home-screen">
        <p class="text-danger">@_error</p>
        <a class="btn btn-primary" href="/">Back to home</a>
    </div>
}
else if (GameClient.RoomCode is null)
{
    <p>Connecting…</p>
}
else if (GameClient.Projection is null)
{
    @* Alone in the room, waiting for the second player: there's no Match/Projection
       yet (only created once the room fills up), so this branch shows the waiting
       room without depending on engine state. *@
    <ConnectionStatusBadge />
    <WaitingRoomView Code="@Code" />
}
else
{
    <ConnectionStatusBadge />

    @switch (GameClient.Projection.Status)
    {
        case GameStatusDto.Lobby:
            <WaitingRoomView Code="@Code" />
            break;
        case GameStatusDto.Setup:
            <CharacterSelectView />
            break;
        case GameStatusDto.Finished:
            <GameOverView />
            break;
        case GameStatusDto.Abandoned:
            <div class="home-screen">
                <p>This room was abandoned.</p>
                <a class="btn btn-primary" href="/">Back to home</a>
            </div>
            break;
        default:
            <GameBoardView />
            break;
    }
}

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        GameClient.Changed += OnChanged;

        var code = Code.Trim().ToUpperInvariant();
        var ok = await GameClient.JoinRoomAsync(code);

        if (!ok)
        {
            _error = GameClient.LastError?.Message ?? "Could not enter the room.";
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GameClient.Changed -= OnChanged;
}
