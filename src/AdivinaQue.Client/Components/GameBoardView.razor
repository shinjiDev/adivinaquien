@implements IDisposable
@inject GameClient GameClient
@inject IJSRuntime JsRuntime

@{
    var projection = GameClient.Projection!;
    var isActivePlayer = projection.ActivePlayerId == GameClient.PlayerId;
    var pendingQuestion = projection.History.LastOrDefault(h => h.Resolution is null);
}

<div class="game-board">
    @if (projection.Status == GameStatusDto.Paused && projection.Pause is not null)
    {
        var opponentPaused = projection.Pause.DisconnectedPlayerId != GameClient.PlayerId;
        <div class="banner warn">
            @if (opponentPaused)
            {
                <span>Tu rival se desconectó. Esperando que vuelva…</span>
            }
            else
            {
                <span>Reconectando…</span>
            }
            @if (GameClient.OpponentDisconnectSecondsRemaining is { } secs)
            {
                <span> (@((int)secs)s de gracia)</span>
            }
        </div>
    }

    <div class="turn-banner @(isActivePlayer ? "yours" : "")">
        @(isActivePlayer ? "Tu turno" : "Turno del rival") — @PhaseLabel(projection.Phase)
    </div>

    <div class="your-card">
        <span>Tu carta:</span>
        <strong>@(YourCardDisplayName(projection.YourCard))</strong>
    </div>

    @if (isActivePlayer && projection.Phase == TurnPhaseDto.AwaitingQuestion)
    {
        <form class="ask-form" @onsubmit="AskAsync" @onsubmit:preventDefault>
            <textarea class="form-control" maxlength="200" placeholder="Escribe tu pregunta…" @bind="_questionText" @bind:event="oninput"></textarea>
            <button class="btn btn-primary w-100 mt-2" type="submit" disabled="@(string.IsNullOrWhiteSpace(_questionText) || _busy)">
                Preguntar
            </button>
        </form>

        <button class="btn @(_guessMode ? "btn-danger" : "btn-outline-danger") w-100 mt-2" @onclick="ToggleGuessMode">
            @(_guessMode ? "Cancelar adivinanza" : "Adivinar carta")
        </button>
    }
    else if (!isActivePlayer && projection.Phase == TurnPhaseDto.AwaitingQuestion)
    {
        <p class="muted">Esperando la pregunta del rival…</p>
    }
    else if (projection.Phase == TurnPhaseDto.AwaitingAnswer)
    {
        @if (!isActivePlayer && pendingQuestion is not null)
        {
            <div class="pending-question">
                <p>@pendingQuestion.Text</p>
                <div class="answer-buttons">
                    <button class="btn btn-success" @onclick='() => AnswerAsync(AnswerDto.Yes)' disabled="@_busy">Sí</button>
                    <button class="btn btn-danger" @onclick='() => AnswerAsync(AnswerDto.No)' disabled="@_busy">No</button>
                    <button class="btn btn-secondary" @onclick='() => AnswerAsync(AnswerDto.NotApplicable)' disabled="@_busy">No aplica</button>
                </div>
            </div>
        }
        else
        {
            <p class="muted">Esperando la respuesta del rival…</p>
        }
    }
    else if (projection.Phase == TurnPhaseDto.AwaitingEliminations)
    {
        @if (isActivePlayer)
        {
            <button class="btn btn-primary w-100" @onclick="EndTurnAsync" disabled="@_busy">Terminar turno</button>
        }
        else
        {
            <p class="muted">El rival está revisando su tablero…</p>
        }
    }

    <div class="card-grid">
        @foreach (var card in projection.Deck)
        {
            <CardTile Card="card"
                      Eliminated="@projection.YourEliminations.Contains(card.Id)"
                      Selectable="true"
                      OnSelect="@(id => CardClickedAsync(id))" />
        }
    </div>

    <div class="history">
        <h3>Historial</h3>
        @if (projection.History.Count == 0)
        {
            <p class="muted">Todavía no hay preguntas.</p>
        }
        else
        {
            <ul>
                @foreach (var entry in projection.History.AsEnumerable().Reverse())
                {
                    <li>
                        <strong>@(entry.AskedByPlayerId == GameClient.PlayerId ? "Tú" : "Rival"):</strong>
                        @entry.Text
                        <em>— @ResolutionLabel(entry.Resolution)</em>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private string _questionText = string.Empty;
    private bool _guessMode;
    private bool _busy;

    protected override void OnInitialized() => GameClient.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GameClient.Changed -= OnChanged;

    private static string YourCardDisplayName(CardDto? card) =>
        card is null ? "?" : string.IsNullOrEmpty(card.Nombre) ? card.Id : card.Nombre;

    private static string PhaseLabel(TurnPhaseDto? phase) => phase switch
    {
        TurnPhaseDto.AwaitingQuestion => "esperando pregunta",
        TurnPhaseDto.AwaitingAnswer => "esperando respuesta",
        TurnPhaseDto.AwaitingEliminations => "tachando cartas",
        _ => string.Empty,
    };

    private static string ResolutionLabel(QuestionResolutionDto? resolution) => resolution switch
    {
        QuestionResolutionDto.Yes => "Sí",
        QuestionResolutionDto.No => "No",
        QuestionResolutionDto.NotApplicable => "No aplica",
        QuestionResolutionDto.Expired => "sin responder (expiró)",
        null => "esperando respuesta…",
        _ => string.Empty,
    };

    private void ToggleGuessMode() => _guessMode = !_guessMode;

    private async Task AskAsync()
    {
        _busy = true;
        await GameClient.AskQuestionAsync(Guid.NewGuid(), _questionText.Trim());
        _questionText = string.Empty;
        _busy = false;
    }

    private async Task AnswerAsync(AnswerDto answer)
    {
        _busy = true;
        await GameClient.SubmitAnswerAsync(Guid.NewGuid(), answer);
        _busy = false;
    }

    private async Task EndTurnAsync()
    {
        _busy = true;
        await GameClient.EndTurnAsync(Guid.NewGuid());
        _busy = false;
    }

    private async Task CardClickedAsync(string cardId)
    {
        if (_guessMode)
        {
            var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "¿Seguro que quieres adivinar esta carta? Termina la partida.");
            if (confirmed)
            {
                _guessMode = false;
                await GameClient.MakeGuessAsync(Guid.NewGuid(), cardId);
            }

            return;
        }

        await GameClient.ToggleEliminationAsync(cardId);
    }
}
