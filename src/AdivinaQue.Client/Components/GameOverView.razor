@implements IDisposable
@inject GameClient GameClient
@inject IJSRuntime JsRuntime

@{
    var projection = GameClient.Projection!;
    var finish = projection.Finish!;
    var youWon = finish.Winner == GameClient.PlayerId;
}

<div class="game-over">
    <h2>@(youWon ? "You won!" : "You lost")</h2>
    <p>@ReasonLabel(finish.Reason)</p>

    <div class="revealed-cards">
        <div>
            <span>Your character</span>
            <CardTile Card="@finish.RevealedCards[GameClient.PlayerId!.Value]" />
        </div>
        <div>
            <span>Rival's character</span>
            <CardTile Card="@OpponentCard(finish)" />
        </div>
    </div>

    <div class="history">
        <h3>Full history</h3>
        <ul>
            @foreach (var entry in projection.History)
            {
                <li>
                    <strong>@(entry.AskedByPlayerId == GameClient.PlayerId ? "You" : "Rival"):</strong>
                    @entry.Text
                    <em>— @ResolutionLabel(entry.Resolution)</em>
                </li>
            }
        </ul>
    </div>

    <a class="btn btn-primary w-100" href="/">Back to home</a>
</div>

@code {
    protected override void OnInitialized()
    {
        GameClient.Changed += OnChanged;

        var youWon = GameClient.Projection!.Finish!.Winner == GameClient.PlayerId;
        if (youWon)
        {
            _ = JsRuntime.InvokeVoidAsync("blazorInterop.playSound", "win");
            _ = JsRuntime.InvokeVoidAsync("blazorInterop.confetti");
        }
        else
        {
            _ = JsRuntime.InvokeVoidAsync("blazorInterop.playSound", "lose");
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GameClient.Changed -= OnChanged;

    private CardDto OpponentCard(FinishInfoDto finish) =>
        finish.RevealedCards.First(kv => kv.Key != GameClient.PlayerId).Value;

    private static string ReasonLabel(FinishReasonDto reason) => reason switch
    {
        FinishReasonDto.CorrectGuess => "Guessed the correct character.",
        FinishReasonDto.WrongGuess => "Guessed the wrong character.",
        FinishReasonDto.Forfeit => "The rival didn't come back in time after disconnecting.",
        FinishReasonDto.Timeout => "The game ended due to a timeout.",
        _ => string.Empty,
    };

    private static string ResolutionLabel(QuestionResolutionDto? resolution) => resolution switch
    {
        QuestionResolutionDto.Yes => "Yes",
        QuestionResolutionDto.No => "No",
        QuestionResolutionDto.NotApplicable => "Not applicable",
        QuestionResolutionDto.Expired => "unanswered (expired)",
        null => "unanswered",
        _ => string.Empty,
    };
}
