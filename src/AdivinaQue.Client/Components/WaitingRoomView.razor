@implements IDisposable
@inject GameClient GameClient

<div class="waiting-room">
    <h2>Sala @Code</h2>
    <img class="qr" src="@QrUrl" alt="Código QR para unirse" />
    <p class="code-display">@Code</p>

    <p>@PlayersText</p>

    @if (!_readyClicked)
    {
        <button class="btn btn-primary btn-lg w-100" @onclick="ReadyAsync">Estoy listo</button>
    }
    else
    {
        <p>Esperando al otro jugador…</p>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private bool _readyClicked;

    protected override void OnInitialized() => GameClient.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GameClient.Changed -= OnChanged;

    private string QrUrl => $"/rooms/{Code}/qr";

    private string PlayersText => GameClient.RoomPlayerIds.Count switch
    {
        1 => "Esperando al segundo jugador…",
        2 => "Los dos jugadores están en la sala.",
        _ => string.Empty,
    };

    private async Task ReadyAsync()
    {
        _readyClicked = true;
        await GameClient.SetReadyAsync();
    }
}
