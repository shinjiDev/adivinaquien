@inherits LayoutComponentBase
@implements IDisposable
@inject GameClient GameClient

<div class="app-shell">
    @if (GameClient.LastError is not null)
    {
        <div class="banner warn error-toast">
            <span>@GameClient.LastError.Message</span>
            <button class="btn-close-toast" @onclick="Dismiss">✕</button>
        </div>
    }

    @Body
</div>

@code {
    protected override void OnInitialized()
    {
        GameClient.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Dismiss() => GameClient.ClearLastError();

    public void Dispose() => GameClient.Changed -= OnChanged;
}
